        {
          "name": "1. GET books - expect 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has data array\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "2. GET books with search_q=python - expect 200 and matching titles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Matching titles contain python\", () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.data).to.be.an(\"array\");",
                  "  pm.expect(res.data.length).to.be.above(0);",
                  "  res.data.forEach(book => pm.expect(book.title.toLowerCase()).to.include(\"python\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=python",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search_q",
                  "value": "python"
                }
              ]
            }
          }
        },
        {
          "name": "3. GET books with order_by=price&order=DESC - expect descending prices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Prices are descending\", () => {",
                  "  const prices = pm.response.json().data.map(b => b.price);",
                  "  for (let i = 0; i < prices.length - 1; i++) {",
                  "    pm.expect(prices[i]).to.be.at.least(prices[i + 1]);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
                }
              ]
            }
          }
        },
